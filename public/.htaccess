# Left on, MultiViews maps /realisations to realisations.html by itself and reads
# the rest of the path as PATH_INFO, so /realisations/<slug> would 404. The rule
# below must be the only thing that maps a URL to a file here.
Options -MultiViews

RewriteEngine On

# Vue Router history mode fallback for files served from dist/.
RewriteRule ^api(/.*)?$ - [L]
RewriteRule ^uploads(/.*)?$ - [L]

# A request that names a file — sitemap.xml, logo.png — and does not exist is a
# real 404. Rewriting it to index.html answered 200 with HTML, which is how
# "sitemap.xml." with one trailing dot was accepted by Search Console and then
# reported as "Sitemap is HTML". The trailing dot is why the pattern allows an
# empty extension. Route segments must therefore carry no dot; none do.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{0,5}$
RewriteRule ^ - [R=404,L]

# Project pages, the only two-segment public route. Their prerendered files are
# flat — projet-<slug>.html — because a dist/realisations/ folder would make
# mod_dir redirect /realisations to /realisations/, shadowing the list page that
# already lives at realisations.html. Checked against a local Apache.
#
# The first condition captures the directory the site is served from, so the
# existence check works both at a document root and in a test subfolder. A slug
# with no file falls through to the SPA below: a project published after the
# last build still opens.
RewriteCond %{REQUEST_URI} ^(.*)/realisations/([^/]+)$
RewriteCond %{DOCUMENT_ROOT}%1/projet-%2.html -f
RewriteRule ^realisations/([^/]+)$ projet-$1.html [L]

# A public route prerendered by scripts/prerender-seo.mjs has its own file, with
# the real <title> and description in the <head>. Serving it here is what a
# crawler that does not run JavaScript reads. Flat file, so the URL keeps no
# trailing slash and Apache adds no redirect.
#
# One segment only. Apache splits /realisations/<slug> into the filename
# dist/realisations plus PATH_INFO /<slug>, so REQUEST_FILENAME.html matched
# realisations.html and every project page 404'd — hence the dedicated rule
# above. pageSeo.json is checked to hold single-segment paths for the same
# reason.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
