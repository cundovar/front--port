RewriteEngine On

# Serve the built Vite app from dist/ when this file is deployed at the
# frontend project root. Do not rewrite requests that are already in dist/.
RewriteRule ^dist/ - [L]
RewriteRule ^api(/.*)?$ - [L]
RewriteRule ^uploads(/.*)?$ - [L]
RewriteRule ^$ dist/index.html [L]
RewriteRule ^(.+)$ dist/$1 [L]
