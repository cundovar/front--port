RewriteEngine On

# Vue Router history mode fallback for files served from dist/.
RewriteRule ^api(/.*)?$ - [L]
RewriteRule ^uploads(/.*)?$ - [L]

# A request that names a file — sitemap.xml, logo.png — and does not exist is a
# real 404. Rewriting it to index.html answered 200 with HTML, which is how a
# mistyped sitemap URL was accepted by Search Console and reported as "Sitemap
# is HTML". Route paths carry no extension, so they are untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{2,5}$
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
